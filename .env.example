# ===========================================
# QUESTEDUCA - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# For Vercel: Add these in Project Settings → Environment Variables

# MongoDB Atlas Connection String
# Get from: https://cloud.mongodb.com → Clusters → Connect
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/questeduca?retryWrites=true&w=majority

# Database Name
DB_NAME=questeduca

# Emergent LLM Key (for Claude quiz generation)
# Get from: Emergent Platform → Profile → Universal Key
EMERGENT_LLM_KEY=sk-emergent-YOUR_KEY_HERE

# Stripe Secret Key
# Get from: https://dashboard.stripe.com/apikeys
# Test: sk_test_... | Live: sk_live_...
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# CORS Origins (your frontend URL)
# For Vercel: https://your-project.vercel.app
CORS_ORIGINS=https://your-project.vercel.app

# Frontend API URL (same as your deployed URL)
REACT_APP_BACKEND_URL=https://your-project.vercel.app
